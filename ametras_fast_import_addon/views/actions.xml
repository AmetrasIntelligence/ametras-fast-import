<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Client action for Import view (default) -->
    <record id="action_csv_import_vue_app" model="ir.actions.client">
        <field name="name">Import</field>
        <field name="tag">ametras_csv_import_vue_app</field>
        <field name="context">{'default_view': 'import'}</field>
    </record>

    <!-- Client action for Profiles view -->
    <record id="action_csv_import_profiles" model="ir.actions.client">
        <field name="name">Profiles</field>
        <field name="tag">ametras_csv_import_vue_app</field>
        <field name="context">{'default_view': 'profiles'}</field>
    </record>

    <!-- Dialog client action for "Start New Import" -->
    <record id="action_csv_import_new_dialog" model="ir.actions.client">
        <field name="name">Start Import</field>
        <field name="tag">ametras_csv_import_vue_app</field>
        <field name="target">new</field>
        <field
            name="context"
        >{'default_view': 'import', 'dialog_size': 'extra-large'}</field>
    </record>

    <!-- Tree view for Logs (landing page) -->
    <record id="view_csv_import_log_tree" model="ir.ui.view">
        <field name="name">csv.import.log.tree</field>
        <field name="model">csv.import.log</field>
        <field name="arch" type="xml">
            <tree create="false" js_class="csv_import_log_list">
                <field name="create_date" string="Date" />
                <field name="user_id" />
                <field name="profile_name" />
                <field
                    name="state"
                    decoration-success="state == 'completed'"
                    decoration-danger="state == 'failed'"
                    decoration-warning="state == 'interrupted'"
                    decoration-info="state == 'running'"
                />
                <field name="is_dry_run" />
                <field name="total_rows" />
                <field name="success_rows" />
                <field name="failed_rows" />
                <field name="pending_rows" />
                <field name="duration_seconds" widget="float_time" />
            </tree>
        </field>
    </record>

    <!-- Form view for Logs (results-style) -->
    <record id="view_csv_import_log_form" model="ir.ui.view">
        <field name="name">csv.import.log.form</field>
        <field name="model">csv.import.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button
                        name="action_resume_import"
                        type="object"
                        string="Resume Import"
                        class="btn-primary"
                        attrs="{'invisible': ['|', ('state', 'not in', ['interrupted', 'failed']), '&amp;', ('pending_rows', '=', 0), ('failed_rows', '=', 0)]}"
                    />
                    <button
                        name="action_retry_failed"
                        type="object"
                        string="Retry Failed Rows"
                        class="btn-primary"
                        attrs="{'invisible': [('failed_rows', '=', 0)]}"
                    />
                    <button
                        name="action_download_errors"
                        type="object"
                        string="Download Error Log"
                        class="btn-secondary"
                        attrs="{'invisible': [('failed_rows', '=', 0)]}"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="running,completed,failed,interrupted"
                    />
                </header>
                <sheet>
                    <group string="Summary">
                        <group>
                            <field name="profile_name" />
                            <field name="profile_id" />
                            <field name="user_id" />
                            <field name="is_dry_run" />
                        </group>
                        <group>
                            <field name="total_rows" />
                            <field name="success_rows" />
                            <field name="failed_rows" />
                            <field name="pending_rows" />
                        </group>
                    </group>
                    <group string="Timing">
                        <group>
                            <field name="started_at" />
                            <field name="finished_at" />
                            <field name="duration_seconds" />
                            <field name="heartbeat" />
                        </group>
                    </group>
                    <group string="Files">
                        <field
                            name="attachment_ids"
                            widget="many2many_tags"
                            nolabel="1"
                        />
                    </group>
                    <notebook>
                        <page string="Files">
                            <field name="filenames" widget="text" />
                        </page>
                        <page string="File Progress">
                            <field name="file_progress" widget="text" />
                        </page>
                        <page string="Error Log">
                            <field name="error_log" widget="text" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window action for Logs (Odoo native list/form) -->
    <record id="action_csv_import_logs" model="ir.actions.act_window">
        <field name="name">Import</field>
        <field name="res_model">csv.import.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Tree view for Profiles (native list/form) -->
    <record id="view_csv_import_profile_tree" model="ir.ui.view">
        <field name="name">csv.import.profile.tree</field>
        <field name="model">csv.import.profile</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="version" />
                <field name="description" />
                <field name="odoo_min_version" />
                <field name="write_date" string="Updated" />
            </tree>
        </field>
    </record>

    <!-- Form view for Profiles (native management) -->
    <record id="view_csv_import_profile_form" model="ir.ui.view">
        <field name="name">csv.import.profile.form</field>
        <field name="model">csv.import.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Profile Name" />
                        <h1>
                            <field name="name" placeholder="e.g. PartX Product Import" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="version" />
                            <field name="odoo_min_version" />
                        </group>
                        <group>
                            <field name="derived_from" readonly="1" />
                            <field name="exported_at" readonly="1" />
                        </group>
                    </group>
                    <field name="description" placeholder="Description..." />
                    <notebook>
                        <page string="Files &amp; Models" name="files">
                            <field name="file_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="filename" />
                                    <field name="model_name" />
                                    <field name="requires" />
                                </tree>
                            </field>
                        </page>
                        <page string="Field Mappings" name="field_mappings">
                            <field name="field_mapping_ids">
                                <tree editable="bottom">
                                    <field name="filename" />
                                    <field name="csv_header" />
                                    <field name="odoo_field" />
                                    <field name="required" />
                                    <field name="transform" />
                                    <field name="notes" />
                                </tree>
                            </field>
                        </page>
                        <page string="Run Settings" name="run_settings">
                            <field name="setting_ids">
                                <tree editable="bottom">
                                    <field name="key" />
                                    <field name="value" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window action for Profiles (Odoo native list/form) -->
    <record id="action_csv_import_profile_list" model="ir.actions.act_window">
        <field name="name">Profiles</field>
        <field name="res_model">csv.import.profile</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
