{
  "name": "ametras-fast-import-vue-app",
  "version": "1.0.1",
  "description": "Vue app for Ametras Fast Import (Odoo addon)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "license": "LGPL-3.0",
  "dependencies": {
    "bootstrap": "^5.3.3",
    "jszip": "^3.10.1",
    "papaparse": "^5.5.2",
    "pinia": "^3.0.2",
    "vue": "^3.5.15",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.0.3",
    "@types/node": "^22.14.1",
    "@types/papaparse": "^5.3.15",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.2",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.3.0",
    "happy-dom": "^20.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.3.5",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.2.8"
  },
  "overrides": {
    "vue-i18n": "^11.2.8"
  }
}
