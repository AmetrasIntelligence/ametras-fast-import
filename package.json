{
  "name": "csv-import",
  "version": "1.0.0",
  "description": "CSV Import Tool for Odoo",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "build": "vue-tsc && vite build && vite build --mode electron",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
  "keywords": [
    "odoo",
    "csv",
    "import"
  ],
  "author": "",
  "license": "LGPL-3.0",
  "type": "module",
  "dependencies": {
    "jszip": "^3.10.1",
    "papaparse": "^5.5.2",
    "pinia": "^3.0.2",
    "vue": "^3.5.15",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^22.14.1",
    "@types/papaparse": "^5.3.15",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.1",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "happy-dom": "^20.5.0",
    "playwright": "^1.58.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.18",
    "vue-tsc": "^2.2.8"
  },
  "build": {
    "appId": "com.odoo.csv-import",
    "productName": "CSV Import",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
